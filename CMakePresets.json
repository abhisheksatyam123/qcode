{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug",
      "description": "Native host build, Debug. Binaries land in build/host-debug/.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "QCODE_BUILD_TUI": "ON",
        "QCODE_BUILD_SERVER": "ON",
        "QCODE_BUILD_CLI": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host Release",
      "description": "Native host build, Release. Binaries land in build/host-release/.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "QCODE_BUILD_TUI": "ON",
        "QCODE_BUILD_SERVER": "ON",
        "QCODE_BUILD_CLI": "ON"
      }
    },
    {
      "name": "android-arm64-v8a-debug",
      "displayName": "Android arm64-v8a Debug",
      "description": "Cross-compile for Android arm64-v8a via NDK toolchain. Requires ANDROID_NDK_HOME. Output: build/android-arm64-v8a-debug/.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64-v8a-debug",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "QCODE_BUILD_TUI": "OFF",
        "QCODE_BUILD_SERVER": "OFF",
        "QCODE_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "android-arm64-v8a-release",
      "displayName": "Android arm64-v8a Release",
      "description": "Cross-compile for Android arm64-v8a via NDK toolchain. Requires ANDROID_NDK_HOME. Output: build/android-arm64-v8a-release/.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64-v8a-release",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "QCODE_BUILD_TUI": "OFF",
        "QCODE_BUILD_SERVER": "OFF",
        "QCODE_BUILD_CLI": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "android-arm64-v8a-debug", "configurePreset": "android-arm64-v8a-debug" },
    { "name": "android-arm64-v8a-release", "configurePreset": "android-arm64-v8a-release" }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    }
  ]
}
