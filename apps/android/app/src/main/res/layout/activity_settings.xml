<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QCode Android Settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Changes take effect after restarting the server."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- ── Free Providers ─────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FREE PROVIDERS"
            android:textColor="#555555"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <!-- OpenCode Zen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenCode Zen API Key (optional — free without key)"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etOpenCodeKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="Leave blank to use free tier"
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <!-- OpenRouter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenRouter API Key (default key provided)"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etOpenRouterKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="sk-or-v1-..."
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginBottom="24dp" />

        <!-- ── Paid Providers ─────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAID PROVIDERS (optional)"
            android:textColor="#555555"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <!-- OpenAI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenAI API Key"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etOpenAiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="sk-..."
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <!-- Anthropic -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anthropic API Key"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etAnthropicKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="sk-ant-..."
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <!-- Groq -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Groq API Key"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etGroqKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="gsk_..."
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginBottom="24dp" />

        <!-- ── Local Providers ─────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCAL PROVIDERS"
            android:textColor="#555555"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <!-- Ollama -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ollama Host URL"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etOllamaHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="http://localhost:11434"
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginBottom="24dp" />

        <!-- ── Workspace ─────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORKSPACE"
            android:textColor="#555555"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workspace Directory"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etWorkspaceDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="/sdcard/qcode_workspace"
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Apply Settings"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
